<resources>
    <style name="Theme.DrivehubKamera.Review" parent="Theme.DrivehubKamera">
        <item name="android:windowBackground">@color/settings_surface</item>
    </style>
    <style name="ReviewButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">52dp</item>
        <item name="android:minWidth">64dp</item><item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item><item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:background">@drawable/bg_dialog_button_secondary</item>
        <item name="android:layout_marginStart">6dp</item><item name="android:paddingHorizontal">14dp</item>
    </style>
    <style name="ReviewCategoryTab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/settings_text_muted</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ReviewIcon" parent="">
        <item name="android:layout_width">56dp</item><item name="android:layout_height">52dp</item>
        <item name="android:padding">14dp</item><item name="android:tint">@color/white</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="ReviewText" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/settings_text_primary</item><item name="android:textSize">18sp</item>
    </style>
</resources>
