<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionDashcam"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- ============ STATUS ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_dashcam_status" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_dashcam_enabled" />

            <TextView
                android:id="@+id/tvDashcamRecordingStatus"
                style="@style/DrivehubSettingsBodyMuted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <Switch
            android:id="@+id/switchDashcamEnabled"
            style="@style/DrivehubSettingsSwitch" />

    </LinearLayout>

    <!-- ============ LOOP RECORDING ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_dashcam_loop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_record_loop" />

            <EditText
                android:id="@+id/etDashcamSegmentMin"
                style="@style/DrivehubSettingsSliderValue"
                android:inputType="number"
                android:maxLength="3" />

        </LinearLayout>

        <TextView
            style="@style/DrivehubSettingsCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/settings_record_loop_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_total_retention" />

            <EditText
                android:id="@+id/etDashcamTotalMin"
                style="@style/DrivehubSettingsSliderValue"
                android:inputType="number"
                android:maxLength="4" />

        </LinearLayout>

        <TextView
            style="@style/DrivehubSettingsCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/settings_total_retention_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_dashcam_fps" />

            <EditText
                android:id="@+id/etDashcamFps"
                style="@style/DrivehubSettingsSliderValue"
                android:inputType="number"
                android:maxLength="2" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_dashcam_signature" />

            <EditText
                android:id="@+id/etDashcamSignature"
                style="@style/DrivehubSettingsSliderValue"
                android:layout_width="220dp"
                android:minHeight="44dp"
                android:gravity="start|center_vertical"
                android:inputType="textCapWords|textNoSuggestions"
                android:imeOptions="flagNoExtractUi"
                android:maxLength="40"
                android:maxLines="1" />

        </LinearLayout>

        <TextView
            style="@style/DrivehubSettingsCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_dashcam_signature_hint" />

    </LinearLayout>

    <!-- ============ RECORDING OVERLAY ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_dashcam_overlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/DrivehubSettingsCardRowLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_dashcam_show_speed" />

        <Switch
            android:id="@+id/switchDashcamShowSpeed"
            style="@style/DrivehubSettingsSwitch" />

    </LinearLayout>

    <!-- ============ STORAGE ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_dashcam_storage" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvDashcamRecordsPath"
            style="@style/DrivehubSettingsBodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btnDashcamExportUsb"
            style="@style/DrivehubDialogButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="@string/settings_export_usb"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
