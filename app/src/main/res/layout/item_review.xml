<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:padding="10dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/reviewItemImage" android:layout_width="104dp" android:layout_height="68dp" android:scaleType="fitCenter" android:importantForAccessibility="no" android:background="@android:color/black" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="0dp">
        <TextView android:id="@+id/reviewItemDate" style="@style/ReviewText" android:textSize="17sp" android:textStyle="bold" android:maxLines="2" />
        <TextView android:id="@+id/reviewItemName" style="@style/ReviewText" android:textSize="13sp" android:textColor="@color/settings_text_secondary" android:maxLines="2" android:ellipsize="middle" />
        <TextView android:id="@+id/reviewItemDetail" style="@style/ReviewText" android:textSize="12sp" android:textColor="@color/settings_text_muted" />
    </LinearLayout>
</LinearLayout>
