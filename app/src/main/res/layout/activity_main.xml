<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/softSnapFullscreenPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/softSnapFullscreenTopRight"
            android:layout_width="160dp"
            android:layout_height="110dp"
            android:background="#55FF3B30" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="@string/main_camera_label_right"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/bg_tishi"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:src="@drawable/bg_tishi"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RelativeLayout
        android:id="@+id/warningBanner"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/bg_tishi"
        app:layout_constraintBottom_toBottomOf="@id/bg_tishi"
        app:layout_constraintStart_toStartOf="@id/bg_tishi"
        app:layout_constraintEnd_toEndOf="@id/bg_tishi">

        <ImageView
            android:id="@+id/eyeImage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_warning_visibility"
            android:layout_toStartOf="@+id/alertTextView" />

        <TextView
            android:id="@+id/alertTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/safety_warning_text"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:singleLine="true" />

    </RelativeLayout>

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/main_button_settings"
        android:padding="24dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings_material"
        android:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/main_button_close_app"
        android:padding="34dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        android:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
