<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/sideCameraWidthLimit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.4" />

    <com.drivehub.kamera.side.SideCameraPanel
        android:id="@+id/sideCameraPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="540:640"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/sideCameraWidthLimit" />

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/sideCameraPanel"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="@string/main_camera_label_right"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/recordingStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_recording_status_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/recordingStatusDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_recording_status_dot" />

        <TextView
            android:id="@+id/tvRecordingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:id="@+id/bg_tishi"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:src="@drawable/bg_tishi"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/surfaceView"
        app:layout_constraintEnd_toEndOf="parent" />

    <RelativeLayout
        android:id="@+id/warningBanner"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/bg_tishi"
        app:layout_constraintBottom_toBottomOf="@id/bg_tishi"
        app:layout_constraintStart_toStartOf="@id/bg_tishi"
        app:layout_constraintEnd_toEndOf="@id/bg_tishi">

        <ImageView
            android:id="@+id/eyeImage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_warning_visibility"
            android:layout_toStartOf="@+id/alertTextView" />

        <TextView
            android:id="@+id/alertTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/safety_warning_text"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:singleLine="true" />

    </RelativeLayout>

    <Button
        android:id="@+id/btnTriggerEventSave"
        android:layout_width="300dp"
        android:layout_height="62dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_recording_test_button"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="@string/main_button_trigger_event_save"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/surfaceView" />

    <Button
        android:id="@+id/btnRecordTestClip"
        android:layout_width="300dp"
        android:layout_height="62dp"
        android:layout_marginBottom="108dp"
        android:background="@drawable/bg_recording_test_button"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="@string/main_button_record_test_30s"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/surfaceView" />

</androidx.constraintlayout.widget.ConstraintLayout>
