<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionCredits"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_open_source_credits" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            style="@style/DrivehubSettingsCreditsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_credits_open_source_body" />

    </LinearLayout>

    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_additional_credits" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            style="@style/DrivehubSettingsCreditsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_credits_additional_body" />

        <TextView
            style="@style/DrivehubSettingsCreditsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_credits_sound_body" />

    </LinearLayout>

</LinearLayout>
