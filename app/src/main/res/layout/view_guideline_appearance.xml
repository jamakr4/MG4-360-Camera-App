<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guidelineAppearanceControl"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:orientation="vertical">
    <TextView style="@style/DrivehubSettingsCardRowLabel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:labelFor="@id/segGuidelineGeometry" android:text="@string/guidelines_geometry" />
    <com.drivehub.kamera.settings.SegmentedControl android:id="@+id/segGuidelineGeometry"
        style="@style/DrivehubSettingsSegmentGroup" android:contentDescription="@string/guidelines_geometry"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/segGuidelineAxles" style="@style/DrivehubSettingsSegmentItem"
            android:layout_width="150dp" android:background="@drawable/bg_settings_segment_start"
            android:text="@string/guidelines_geometry_axles_short" />
        <TextView android:id="@+id/segGuidelineFrontBumper" style="@style/DrivehubSettingsSegmentItem"
            android:layout_width="150dp" android:background="@drawable/bg_settings_segment_end"
            android:text="@string/guidelines_geometry_front_bumper_short" />
    </com.drivehub.kamera.settings.SegmentedControl>
    <TextView style="@style/DrivehubSettingsCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/guidelines_geometry_hint" />
    <TextView style="@style/DrivehubSettingsCardRowLabel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:labelFor="@id/segGuidelineStyle" android:text="@string/guidelines_style" />
    <com.drivehub.kamera.settings.SegmentedControl android:id="@+id/segGuidelineStyle"
        style="@style/DrivehubSettingsSegmentGroup" android:contentDescription="@string/guidelines_style"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/segGuidelineLines" style="@style/DrivehubSettingsSegmentItem"
            android:layout_width="120dp" android:background="@drawable/bg_settings_segment_start"
            android:text="@string/guidelines_style_lines" />
        <TextView android:id="@+id/segGuidelineOuterLines" style="@style/DrivehubSettingsSegmentItem"
            android:layout_width="120dp" android:background="@drawable/bg_settings_segment_middle"
            android:text="@string/guidelines_style_outer_lines" />
        <TextView android:id="@+id/segGuidelineSimple" style="@style/DrivehubSettingsSegmentItem"
            android:layout_width="120dp" android:background="@drawable/bg_settings_segment_end"
            android:text="@string/guidelines_style_simple" />
    </com.drivehub.kamera.settings.SegmentedControl>
    <TextView style="@style/DrivehubSettingsCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/guidelines_style_hint" />
</LinearLayout>
