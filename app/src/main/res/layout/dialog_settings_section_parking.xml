<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sectionParking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">


    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_parking_main_view" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/show_safety_warning" />

            <Switch
                android:id="@+id/switchSafetyWarning"
                style="@style/DrivehubSettingsSwitch"
                android:contentDescription="@string/show_safety_warning" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/DrivehubSettingsCardRowLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/parkingBirdseyeCarColorPicker"
            android:text="@string/settings_parking_car_color" />

        <com.drivehub.kamera.settings.BirdseyeCarColorPicker
            android:id="@+id/parkingBirdseyeCarColorPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/parkingGuidelinesSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView style="@style/DrivehubSettingsCardLabel"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="0dp" android:text="@string/guidelines_title" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:minHeight="48dp" android:orientation="horizontal">
            <TextView style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:labelFor="@id/switchGuidelineSpeedLimit" android:text="@string/guidelines_speed_threshold" />
            <EditText android:id="@+id/etGuidelineSpeed" style="@style/DrivehubSettingsSliderValue"
                android:layout_marginStart="16dp" android:contentDescription="@string/guidelines_speed_description"
                android:imeOptions="actionDone" android:inputType="number" android:maxLength="3" />
            <TextView style="@style/DrivehubSettingsCaption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:layout_marginEnd="16dp"
                android:text="@string/parking_automation_speed_unit" />
            <Switch android:id="@+id/switchGuidelineSpeedLimit" style="@style/DrivehubSettingsSwitch"
                android:contentDescription="@string/guidelines_speed_threshold" />
        </LinearLayout>
        <TextView style="@style/DrivehubSettingsCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/guidelines_speed_hint" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center_vertical"
            android:minHeight="48dp" android:orientation="horizontal">
            <TextView style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:labelFor="@id/segGuidelineStyle" android:text="@string/guidelines_style" />
            <com.drivehub.kamera.settings.SegmentedControl android:id="@+id/segGuidelineStyle"
                style="@style/DrivehubSettingsSegmentGroup" android:contentDescription="@string/guidelines_style">
                <TextView android:id="@+id/segGuidelineLines" style="@style/DrivehubSettingsSegmentItem"
                    android:layout_width="120dp" android:background="@drawable/bg_settings_segment_start"
                    android:text="@string/guidelines_style_lines" />
                <TextView android:id="@+id/segGuidelineSimple" style="@style/DrivehubSettingsSegmentItem"
                    android:layout_width="120dp" android:background="@drawable/bg_settings_segment_end"
                    android:text="@string/guidelines_style_simple" />
            </com.drivehub.kamera.settings.SegmentedControl>
        </LinearLayout>
        <TextView style="@style/DrivehubSettingsCaption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/guidelines_style_hint" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/rowParkingWheelAlignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:screenReaderFocusable="true">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_parking_wheel_alignment" />

            <ImageView
                android:id="@+id/ivParkingWheelAlignmentChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/settings_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/parkingWheelAlignmentOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/DrivehubSettingsCardRowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_parking_front_axle" />

                <com.drivehub.kamera.settings.SegmentedControl
                    android:id="@+id/segParkingFrontWheelAlignment"
                    style="@style/DrivehubSettingsSegmentGroup"
                    android:contentDescription="@string/settings_parking_front_axle">
                    <TextView android:id="@+id/segParkingFrontNone" style="@style/DrivehubSettingsSegmentItem"
                        android:layout_width="76dp" android:background="@drawable/bg_settings_segment_start"
                        android:text="@string/settings_parking_alignment_none" />
                    <TextView android:id="@+id/segParkingFrontBasic" style="@style/DrivehubSettingsSegmentItem"
                        android:layout_width="76dp" android:background="@drawable/bg_settings_segment_middle"
                        android:text="@string/settings_parking_alignment_basic" />
                    <TextView android:id="@+id/segParkingFrontAdvanced" style="@style/DrivehubSettingsSegmentItem"
                        android:layout_width="108dp" android:background="@drawable/bg_settings_segment_end"
                        android:text="@string/settings_parking_alignment_advanced" />
                </com.drivehub.kamera.settings.SegmentedControl>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/DrivehubSettingsCardRowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_parking_rear_axle" />

                <com.drivehub.kamera.settings.SegmentedControl
                    android:id="@+id/segParkingRearWheelAlignment"
                    style="@style/DrivehubSettingsSegmentGroup"
                    android:contentDescription="@string/settings_parking_rear_axle">
                    <TextView android:id="@+id/segParkingRearNone" style="@style/DrivehubSettingsSegmentItem"
                        android:layout_width="76dp" android:background="@drawable/bg_settings_segment_start"
                        android:text="@string/settings_parking_alignment_none" />
                    <TextView android:id="@+id/segParkingRearBasic" style="@style/DrivehubSettingsSegmentItem"
                        android:layout_width="76dp" android:background="@drawable/bg_settings_segment_middle"
                        android:text="@string/settings_parking_alignment_basic" />
                    <TextView android:id="@+id/segParkingRearAdvanced" style="@style/DrivehubSettingsSegmentItem"
                        android:layout_width="108dp" android:background="@drawable/bg_settings_segment_end"
                        android:text="@string/settings_parking_alignment_advanced" />
                </com.drivehub.kamera.settings.SegmentedControl>
            </LinearLayout>

            <TextView style="@style/DrivehubSettingsCaption" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="8dp"
                android:text="@string/settings_parking_wheel_modes_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/DrivehubSettingsCardRowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_parking_highlight_missing_areas" />

                <Switch
                    android:id="@+id/switchParkingHighlightMissingAreas"
                    style="@style/DrivehubSettingsSwitch"
                    android:contentDescription="@string/settings_parking_highlight_missing_areas" />
            </LinearLayout>

            <TextView
                style="@style/DrivehubSettingsCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_parking_highlight_missing_areas_hint" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/DrivehubSettingsCardRowLabel" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/settings_parking_side_correction" />
            <com.drivehub.kamera.settings.SegmentedControl
                android:id="@+id/segParkingSideCorrection"
                style="@style/DrivehubSettingsSegmentGroup"
                android:contentDescription="@string/settings_parking_side_correction">
                <TextView android:id="@+id/segParkingSideNone" style="@style/DrivehubSettingsSegmentItem"
                    android:layout_width="120dp" android:background="@drawable/bg_settings_segment_start"
                    android:text="@string/settings_parking_alignment_none" />
                <TextView android:id="@+id/segParkingSideStraight" style="@style/DrivehubSettingsSegmentItem"
                    android:layout_width="120dp" android:background="@drawable/bg_settings_segment_end"
                    android:text="@string/settings_parking_alignment_straight" />
            </com.drivehub.kamera.settings.SegmentedControl>
        </LinearLayout>
        <TextView style="@style/DrivehubSettingsCaption" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp"
            android:text="@string/settings_parking_side_correction_hint" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            style="@style/DrivehubSettingsCardLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:text="@string/parking_automation_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/switchParkingAutoClose"
                android:text="@string/parking_auto_close" />

            <EditText
                android:id="@+id/etParkingAutoCloseSpeed"
                style="@style/DrivehubSettingsSliderValue"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/parking_auto_close_speed"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="3" />

            <TextView
                style="@style/DrivehubSettingsCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                android:text="@string/parking_automation_speed_unit" />

            <Switch
                android:id="@+id/switchParkingAutoClose"
                style="@style/DrivehubSettingsSwitch"
                android:contentDescription="@string/parking_auto_close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/switchParkingAutoOpenDrive"
                android:text="@string/parking_auto_open_drive" />

            <Switch
                android:id="@+id/switchParkingAutoOpenDrive"
                style="@style/DrivehubSettingsSwitch"
                android:contentDescription="@string/parking_auto_open_drive" />
        </LinearLayout>

        <TextView
            style="@style/DrivehubSettingsCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/parking_automation_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/switchParkingAutoCloseOnPark"
                android:text="@string/parking_auto_close_on_park" />

            <Switch
                android:id="@+id/switchParkingAutoCloseOnPark"
                style="@style/DrivehubSettingsSwitch"
                android:contentDescription="@string/parking_auto_close_on_park" />
        </LinearLayout>

        <TextView
            style="@style/DrivehubSettingsCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/parking_auto_close_on_park_hint" />
    </LinearLayout>


</LinearLayout>
