<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionDev"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- ============ POLLING RATES ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_dev_polling_rates" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_dev_default_poll" />

            <EditText
                android:id="@+id/etDevDefaultPollMs"
                style="@style/DrivehubSettingsSliderValue"
                android:inputType="number"
                android:maxLength="4" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_dev_signal_off_poll" />

            <EditText
                android:id="@+id/etDevSignalOffPollMs"
                style="@style/DrivehubSettingsSliderValue"
                android:inputType="number"
                android:maxLength="4" />

        </LinearLayout>

        <TextView
            style="@style/DrivehubSettingsCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_dev_polling_rates_hint" />

        <Button
            android:id="@+id/btnDevResetDefaults"
            style="@style/DrivehubDialogButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="@string/settings_dev_reset_defaults" />

    </LinearLayout>

    <!-- ============ BANNER TEST ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_dev_banner_test" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            style="@style/DrivehubSettingsBodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/settings_dev_banner_test_hint" />

        <Button
            android:id="@+id/btnDevTestDashcamBanner"
            style="@style/DrivehubDialogButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/settings_dev_banner_test" />

    </LinearLayout>

</LinearLayout>
