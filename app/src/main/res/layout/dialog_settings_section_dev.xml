<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionDev"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        style="@style/DrivehubSettingsHeading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/settings_section_dev" />

    <TextView
        style="@style/DrivehubSettingsBodyMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_dev_hint" />

    <TextView
        style="@style/DrivehubSettingsHeading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp"
        android:text="@string/settings_dev_polling_rates" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/DrivehubSettingsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_dev_default_poll" />

        <EditText
            android:id="@+id/etDevDefaultPollMs"
            style="@style/DrivehubSettingsSliderValue"
            android:inputType="number"
            android:maxLength="4" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/DrivehubSettingsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_dev_signal_off_poll" />

        <EditText
            android:id="@+id/etDevSignalOffPollMs"
            style="@style/DrivehubSettingsSliderValue"
            android:inputType="number"
            android:maxLength="4" />

    </LinearLayout>

    <TextView
        style="@style/DrivehubSettingsCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/settings_dev_polling_rates_hint" />

    <Button
        android:id="@+id/btnDevResetDefaults"
        style="@style/DrivehubDialogButtonSecondary"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:text="@string/settings_dev_reset_defaults" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="16dp"
        android:background="@color/settings_divider" />

    <TextView
        style="@style/DrivehubSettingsHeading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_dev_banner_test" />

    <TextView
        style="@style/DrivehubSettingsBodyMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/settings_dev_banner_test_hint" />

    <Button
        android:id="@+id/btnDevTestDashcamBanner"
        style="@style/DrivehubDialogButtonSecondary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/settings_dev_banner_test" />

</LinearLayout>
