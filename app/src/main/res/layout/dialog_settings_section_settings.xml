<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionSettings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_display" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/DrivehubSettingsCardRowLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/show_safety_warning" />

        <Switch
            android:id="@+id/switchSafetyWarning"
            style="@style/DrivehubSettingsSwitch" />

    </LinearLayout>

    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_accent_color" />

    <LinearLayout
        android:id="@+id/rowAccentColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/viewAccentPreview"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_accent_color_preview" />

        <EditText
            android:id="@+id/etAccentColor"
            style="@style/DrivehubSettingsAccentValue"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:hint="@string/settings_accent_color_hint" />

    </LinearLayout>

</LinearLayout>
