<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="560dp"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:tint="@color/settings_accent"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/settings_dialog_close"
            android:focusable="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/tabSettings"
            style="@style/DrivehubSettingsTabInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_tab_settings" />

        <TextView
            android:id="@+id/tabSignalCamera"
            style="@style/DrivehubSettingsTabInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_tab_signal_camera" />

        <TextView
            android:id="@+id/tabDashcam"
            style="@style/DrivehubSettingsTabInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_tab_dashcam" />

        <TextView
            android:id="@+id/tabOptik"
            style="@style/DrivehubSettingsTabInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_tab_optik" />

        <TextView
            android:id="@+id/tabUpdate"
            style="@style/DrivehubSettingsTabActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_tab_update" />

        <TextView
            android:id="@+id/tabCredits"
            style="@style/DrivehubSettingsTabInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/settings_tab_credits" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="8dp"
        android:background="@color/settings_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Android resource folders do not support free nested subfolders here,
                 so the dialog is split into separate include files with a clear prefix instead. -->
            <include layout="@layout/dialog_settings_section_update" />

            <include layout="@layout/dialog_settings_section_settings" />

            <include layout="@layout/dialog_settings_section_signal_camera" />

            <include layout="@layout/dialog_settings_section_dashcam" />

            <include layout="@layout/dialog_settings_section_optik" />

            <include layout="@layout/dialog_settings_section_credits" />

        </FrameLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDialogVersion"
            style="@style/DrivehubSettingsFooterVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_version_unknown" />

        <TextView
            android:id="@+id/tvDialogVersionBeta"
            style="@style/DrivehubSettingsFooterBeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings_version_beta"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDialogUpdateTag"
            style="@style/DrivehubSettingsFooterTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ota_status_checking" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDialogFooterAuthor"
        style="@style/DrivehubSettingsFooterAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:text="by jamakr4 &amp; merth4n" />

</LinearLayout>
