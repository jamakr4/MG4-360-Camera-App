<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="560dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_settings_card">

    <!-- ============ SIDEBAR ============ -->
    <LinearLayout
        android:layout_width="208dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings_dialog_close"
            android:focusable="false"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:tint="@color/settings_accent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabSettings"
                    style="@style/DrivehubSettingsTabInactive"
                    android:text="@string/settings_tab_settings" />

                <TextView
                    android:id="@+id/tabSignalCamera"
                    style="@style/DrivehubSettingsTabInactive"
                    android:text="@string/settings_tab_signal_camera" />

                <TextView
                    android:id="@+id/tabDigitalRearview"
                    style="@style/DrivehubSettingsTabInactive"
                    android:text="@string/settings_tab_digital_rearview" />

                <TextView
                    android:id="@+id/tabDashcam"
                    style="@style/DrivehubSettingsTabInactive"
                    android:text="@string/settings_tab_dashcam" />

                <TextView
                    android:id="@+id/tabUpdate"
                    style="@style/DrivehubSettingsTabInactive"
                    android:text="@string/settings_tab_update" />

                <TextView
                    android:id="@+id/tabCredits"
                    style="@style/DrivehubSettingsTabInactive"
                    android:text="@string/settings_tab_credits" />

                <TextView
                    android:id="@+id/tabDev"
                    style="@style/DrivehubSettingsTabInactive"
                    android:text="@string/settings_tab_dev"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tabDevStatus"
                    style="@style/DrivehubSettingsTabInactive"
                    android:text="@string/settings_tab_dev_status"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/tvDialogUpdateTag"
            style="@style/DrivehubSettingsFooterTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ota_status_checking" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDialogVersion"
                style="@style/DrivehubSettingsFooterVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_version_unknown" />

            <TextView
                android:id="@+id/tvDialogVersionBeta"
                style="@style/DrivehubSettingsFooterBeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings_version_beta"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDialogFooterAuthor"
            style="@style/DrivehubSettingsFooterAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:text="by jamakr4 &amp; merth4n" />

    </LinearLayout>

    <!-- ============ DIVIDER ============ -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/settings_divider" />

    <!-- ============ CONTENT ============ -->
    <ScrollView
        android:id="@+id/settingsContentScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingTop="22dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <include layout="@layout/dialog_settings_section_update" />

            <include layout="@layout/dialog_settings_section_settings" />

            <include layout="@layout/dialog_settings_section_signal_camera" />

            <include layout="@layout/dialog_settings_section_digital_rearview" />

            <include layout="@layout/dialog_settings_section_dashcam" />

            <include layout="@layout/dialog_settings_section_credits" />

            <include layout="@layout/dialog_settings_section_dev" />

            <include layout="@layout/dialog_settings_section_dev_status" />

        </FrameLayout>
    </ScrollView>

</LinearLayout>
