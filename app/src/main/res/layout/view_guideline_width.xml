<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guidelineWidthControl"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:orientation="vertical">
    <TextView style="@style/DrivehubSettingsCardRowLabel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:labelFor="@id/segGuidelineWidth" android:text="@string/guidelines_width" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center_vertical"
        android:minHeight="48dp" android:orientation="horizontal">
        <com.drivehub.kamera.settings.SegmentedControl android:id="@+id/segGuidelineWidth"
            style="@style/DrivehubSettingsSegmentGroup" android:contentDescription="@string/guidelines_width">
            <TextView android:id="@+id/segGuidelineWidthMirrors" style="@style/DrivehubSettingsSegmentItem"
                android:layout_width="100dp" android:background="@drawable/bg_settings_segment_start"
                android:text="@string/guidelines_width_mirrors_short" />
            <TextView android:id="@+id/segGuidelineWidthBody" style="@style/DrivehubSettingsSegmentItem"
                android:layout_width="100dp" android:background="@drawable/bg_settings_segment_middle"
                android:text="@string/guidelines_width_body_short" />
            <TextView android:id="@+id/segGuidelineWidthCustom" style="@style/DrivehubSettingsSegmentItem"
                android:layout_width="100dp" android:background="@drawable/bg_settings_segment_end"
                android:text="@string/guidelines_width_custom_short" />
        </com.drivehub.kamera.settings.SegmentedControl>
        <LinearLayout android:id="@+id/rowGuidelineCustomWidth"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="center_vertical" android:minHeight="48dp"
            android:orientation="horizontal" android:visibility="gone">
            <EditText android:id="@+id/etGuidelineCustomWidth" style="@style/DrivehubSettingsSliderValue"
                android:layout_marginStart="0dp"
                android:contentDescription="@string/guidelines_width_custom_description"
                android:imeOptions="actionDone" android:inputType="number" android:singleLine="true" />
            <TextView style="@style/DrivehubSettingsCaption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="@string/guidelines_width_unit" />
        </LinearLayout>
        <TextView android:id="@+id/textGuidelineWidthValue" style="@style/DrivehubSettingsCaption"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView style="@style/DrivehubSettingsCaption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/guidelines_width_hint" />
</LinearLayout>
