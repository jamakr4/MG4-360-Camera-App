<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionUpdate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ============ UPDATE CHANNEL ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_update_channel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <TextView
                style="@style/DrivehubSettingsCardRowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_allow_beta_updates" />

            <Switch
                android:id="@+id/switchAllowBetaUpdates"
                style="@style/DrivehubSettingsSwitch" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvUpdateChannelStatus"
            style="@style/DrivehubSettingsBodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ota_update_channel_loading" />

    </LinearLayout>

    <!-- ============ SOURCE STATUS ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_update_status" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvUpdateSourceGithub"
            style="@style/DrivehubSettingsBodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ota_source_status_loading" />

        <TextView
            android:id="@+id/tvUpdateSourceGitlab"
            style="@style/DrivehubSettingsBodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ota_source_status_loading" />

    </LinearLayout>

    <!-- ============ LATEST RELEASE ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_latest_release" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvUpdateReleaseTitle"
            style="@style/DrivehubSettingsCardRowLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ota_update_section_loading" />

        <TextView
            style="@style/DrivehubSettingsBodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ota_update_hint" />

    </LinearLayout>

    <!-- ============ CHANGELOG ============ -->
    <TextView
        style="@style/DrivehubSettingsCardLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_changelog" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_inline_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvUpdateChangelog"
            style="@style/DrivehubSettingsChangelogBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ota_update_changelog_loading"
            android:textIsSelectable="false" />

    </LinearLayout>

</LinearLayout>
