<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityPaneTitle="@string/settings_oem_disable_warning_title"
    android:background="@drawable/bg_settings_card"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvOemDisableWarningTitle"
            style="@style/DrivehubSettingsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:accessibilityHeading="true"
            android:text="@string/settings_oem_disable_warning_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOemDisableWarningMessage"
            style="@style/DrivehubSettingsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOemDisableCancel"
                style="@style/DrivehubDialogButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@null"
                android:minHeight="48dp"
                android:text="@string/settings_oem_disable_cancel"
                android:textAllCaps="false"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOemDisableConfirm"
                style="@style/DrivehubDialogButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/settings_oem_disable_confirm"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
